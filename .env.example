# EXAMPLE ONLY. Copy to .env locally; never commit .env.
APP_ENV=local
RAG_BACKEND=stage6
ENABLE_WEB_SEARCH=false
STAGE6_PACKAGE=reference_pipelines/stage6
# configure_agentic.py preserves your EXISTING accepted workspace; never initialize an empty one.
STAGE6_WORKSPACE=data/stage6_workspace
STAGE6_MODEL_CACHE=model_cache
STAGE4_PACKAGE=reference_pipelines/stage4
STAGE2_EVIDENCE_DATA=data/stage2_evidence
RESEARCH_SOURCE_REGISTRY=config/research_sources.json
RESEARCH_OUTPUT_ROOT=data/research_runs
RESEARCH_JOB_SECONDS=2400
RESEARCH_MAX_JOBS=2
# Optional local paths; no downloads are attempted.
# STAGE6_MODEL_PATH=G:/path/to/existing/pinned/model/snapshot
# STAGE4_TESSERACT=C:/Program Files/Tesseract-OCR/tesseract.exe
# STAGE4_OCR_MODELS=G:/path/to/existing/Stage4/models
