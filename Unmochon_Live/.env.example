# Keep this folder as the application root. Python 3.11 or 3.12.
RAG_BACKEND=original
ENABLE_WEB_SEARCH=false
ORIGINAL_DATA_DIR=data
CHROMADB_DIR=data/chromedb
BM25_INDEX_PATH=data/bm25_index.pkl
PROCESSED_DIR=data/processed_jsonl
DOC_METADATA_PATH=data/doc_metadata.json
RAW_PDF_DIR=data/raw_pdfs
# Must match existing 384-dimensional vectors. A local copy of the SAME model is OK.
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
GEMINI_API_KEY=
# Original setting, configurable without changing explanation logic.
GEMINI_MODEL=gemini-3.6-flash
APP_ENV=local
API_KEY=
PORT=8000
